# ─── SUPABASE (Backend & Database) ─────────────────────────────────────────────
# Wajib diisi untuk backend cloud Supabase (PRD §8).
# Didapat dari: Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── GOOGLE BOOKS API (Pencarian Katalog Buku) ─────────────────────────────────
# Opsional namun sangat disarankan agar kuota pencarian buku lebih besar.
# Jika kosong, aplikasi menggunakan akses publik unauthenticated / fallback Open Library.
GOOGLE_BOOKS_API_KEY=

# ─── LLM CHATBOT (AI Teman Baca) ──────────────────────────────────────────────
# StoryLoka menggunakan DeepSeek Chat sebagai LLM primer dengan fallback ke Gemini.
# DeepSeek API Key (Primer) didapat dari platform.deepseek.com:
DEEPSEEK_API_KEY=

# Google Gemini API Key (Fallback jika DeepSeek gagal/kuota habis):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-3.5-flash

# ─── PETA TOKO BUKU (Leaflet / OpenStreetMap) ──────────────────────────────────
# URL tile server peta bawaan StoryLoka.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

